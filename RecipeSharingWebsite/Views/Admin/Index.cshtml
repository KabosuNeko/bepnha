@model IEnumerable<RecipeSharingWebsite.Models.Recipe>
@using RecipeSharingWebsite.Models

@{
    ViewBag.Title = "Duyệt bài";
    string status = ViewBag.Status;
}

<div class="mb-4">
    <span class="kicker">Quản trị</span>
    <h1 class="mb-0">Duyệt bài đăng</h1>
</div>

@* 3 tab theo trạng thái *@
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(status == Recipe.ChoDuyet ? "active" : "")" href="@Url.Action("Index", new { status = Recipe.ChoDuyet })">
            Chờ duyệt <span class="badge text-bg-warning">@ViewBag.SoChoDuyet</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(status == Recipe.DaDuyet ? "active" : "")" href="@Url.Action("Index", new { status = Recipe.DaDuyet })">Đã duyệt</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(status == Recipe.BiXoa ? "active" : "")" href="@Url.Action("Index", new { status = Recipe.BiXoa })">Bị xóa</a>
    </li>
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có bài nào ở mục "@status".</div>
}

@foreach (var item in Model)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="row g-0">
            <div class="col-md-3">
                <img src="@Url.Content(item.ImagePath ?? "~/Content/Images/placeholder.svg")" class="w-100 h-100 object-fit-cover rounded-start" style="min-height:160px" alt="@item.Title" />
            </div>
            <div class="col-md-9">
                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <span class="badge badge-accent">@item.Category.CategoryName</span>
                            <h5 class="card-title mt-2 mb-1">
                                <a href="@Url.Action("Details", "Recipes", new { id = item.RecipeID })">@item.Title</a>
                            </h5>
                            <p class="text-muted small mb-2">
                                <i class="bi bi-person me-1"></i>@item.Author
                                <span class="mx-1">·</span><i class="bi bi-calendar3 me-1"></i>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                    </div>
                    <p class="card-text small">@item.Description</p>

                    @if (item.Status == Recipe.BiXoa)
                    {
                        <div class="alert alert-danger small py-2 mb-2">Lý do đã gửi: @item.RejectReason</div>
                    }

                    <div class="d-flex flex-wrap gap-2 align-items-start">
                        @if (item.Status != Recipe.DaDuyet)
                        {
                            using (Html.BeginForm("Approve", "Admin", new { id = item.RecipeID }, FormMethod.Post, null))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Duyệt</button>
                            }
                        }
                        @if (item.Status != Recipe.BiXoa)
                        {
                            using (Html.BeginForm("Reject", "Admin", new { id = item.RecipeID }, FormMethod.Post, new { @class = "flex-grow-1" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="input-group input-group-sm">
                                    <input type="text" name="reason" class="form-control" maxlength="500" required placeholder="Lý do xóa (gửi cho người đăng)" />
                                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
