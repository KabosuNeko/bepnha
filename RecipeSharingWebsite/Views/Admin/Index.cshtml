@model IEnumerable<RecipeSharingWebsite.Models.Recipe>
@using RecipeSharingWebsite.Models

@{
    ViewBag.Title = "Duyệt bài";
    string status = ViewBag.Status;
}

<div class="mb-4">
    <h1 class="mb-0">Duyệt bài đăng</h1>
</div>

@* ===== Thống kê nhanh: số liệu đếm từ database ===== *@
@{ var monDiemCao = (Recipe)ViewBag.MonDiemCao; }
<div class="bg-cream rounded-3 p-3 p-md-4 mb-4">
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3">
            <div class="fs-3 fw-bold">@ViewBag.SoDaDuyet</div>
            <div class="text-muted small">món đang hiện</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-3 fw-bold">@ViewBag.SoChoDuyet</div>
            <div class="text-muted small">món chờ duyệt</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-3 fw-bold">@ViewBag.SoTaiKhoan</div>
            <div class="text-muted small">tài khoản</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="fs-3 fw-bold">@ViewBag.SoDanhGia</div>
            <div class="text-muted small">lượt đánh giá</div>
        </div>
    </div>
    @if (monDiemCao != null)
    {
        <p class="small mb-0 mt-3 text-center">
            Điểm cao nhất:
            <a class="fw-semibold" href="@Url.Action("Details", "Recipes", new { id = monDiemCao.RecipeID })">@monDiemCao.Title</a>
            (@monDiemCao.Ratings.Average(r => r.Stars).ToString("0.0") sao, @monDiemCao.Ratings.Count lượt)
        </p>
    }
</div>

@* 3 tab theo trạng thái, kèm số bài mỗi tab *@
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link @(status == Recipe.ChoDuyet ? "active" : "")" href="@Url.Action("Index", new { status = Recipe.ChoDuyet })">
            Chờ duyệt <span class="badge text-bg-warning">@ViewBag.SoChoDuyet</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(status == Recipe.DaDuyet ? "active" : "")" href="@Url.Action("Index", new { status = Recipe.DaDuyet })">Đã duyệt (@ViewBag.SoDaDuyet)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(status == Recipe.BiXoa ? "active" : "")" href="@Url.Action("Index", new { status = Recipe.BiXoa })">Bị xóa (@ViewBag.SoBiXoa)</a>
    </li>
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">Không có bài nào ở mục "@status".</div>
}

@foreach (var item in Model)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="row g-0">
            <div class="col-md-3">
                <img src="@Url.Content(item.ImagePath ?? "~/Content/Images/placeholder.svg")" class="w-100 h-100 object-fit-cover rounded-start" style="min-height:160px" width="300" height="200" loading="lazy" alt="@item.Title" />
            </div>
            <div class="col-md-9">
                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <span class="badge badge-accent">@item.Category.CategoryName</span>
                            <h5 class="card-title mt-2 mb-1">
                                <a href="@Url.Action("Details", "Recipes", new { id = item.RecipeID })">@item.Title</a>
                            </h5>
                            <p class="text-muted small mb-2">
                                @item.Author
                                <span class="mx-1">·</span>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                    </div>
                    <p class="card-text small">@item.Description</p>

                    @if (item.Status == Recipe.BiXoa)
                    {
                        <div class="alert alert-danger small py-2 mb-2">Lý do đã gửi: @item.RejectReason</div>
                    }

                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        @if (item.Status != Recipe.DaDuyet)
                        {
                            using (Html.BeginForm("Approve", "Admin", new { id = item.RecipeID }, FormMethod.Post, null))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success">Duyệt</button>
                            }
                        }
                        @if (item.Status != Recipe.BiXoa)
                        {
                            using (Html.BeginForm("Reject", "Admin", new { id = item.RecipeID }, FormMethod.Post, new { @class = "flex-grow-1" }))
                            {
                                @Html.AntiForgeryToken()
                                <label for="lyDo-@item.RecipeID" class="form-label small fw-semibold mb-1">Lý do xóa</label>
                                <div class="input-group">
                                    <input type="text" name="reason" id="lyDo-@item.RecipeID" class="form-control" maxlength="500" required placeholder="Lý do xóa (gửi cho người đăng)" />
                                    <button type="submit" class="btn btn-outline-danger">Xóa</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
