@model RecipeSharingWebsite.Models.Category

@{
    ViewBag.Title = "Thêm danh mục";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Danh mục</a></li>
        <li class="breadcrumb-item active" aria-current="page">Thêm danh mục</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-cream py-3">
                <h1 class="h3 mb-0">Thêm danh mục</h1>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        @Html.LabelFor(model => model.CategoryName, htmlAttributes: new { @class = "form-label fw-semibold" })
                        @Html.EditorFor(model => model.CategoryName, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Món nước" } })
                        @Html.ValidationMessageFor(model => model.CategoryName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-label fw-semibold" })
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "3", placeholder = "Mô tả ngắn cho danh mục" })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Thêm</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
