@model IEnumerable<RecipeSharingWebsite.Models.Category>

@{
    ViewBag.Title = "Danh mục";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="mb-0">Danh mục món ăn</h1>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create")">Thêm danh mục</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">@Html.DisplayNameFor(model => model.CategoryName)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th class="text-center">Số công thức</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 fw-semibold">
                            <a href="@Url.Action("Index", "Recipes", new { categoryID = item.CategoryID })">@item.CategoryName</a>
                        </td>
                        <td class="text-muted">@item.Description</td>
                        <td class="text-center">
                            <span class="badge rounded-pill badge-accent">@item.Recipes.Count</span>
                        </td>
                        <td class="text-end pe-4 text-nowrap">
                            <a class="btn btn-outline-secondary" href="@Url.Action("Edit", new { id = item.CategoryID })">Sửa</a>
                            <a class="btn btn-outline-danger" href="@Url.Action("Delete", new { id = item.CategoryID })">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
