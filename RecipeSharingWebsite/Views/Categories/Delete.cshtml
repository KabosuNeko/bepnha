@model RecipeSharingWebsite.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Danh mục</a></li>
        <li class="breadcrumb-item active" aria-current="page">Xóa danh mục</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        @if (ViewBag.Err != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@ViewBag.Err</div>
        }

        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-1"></i> Bạn có chắc muốn xóa danh mục này?
            </div>
            <div class="card-body p-4">
                <h2 class="h3">@Model.CategoryName</h2>
                <p class="text-muted">@Model.Description</p>
                <p>Số công thức trong danh mục: <span class="badge rounded-pill badge-accent">@Model.Recipes.Count</span></p>

                @if (Model.Recipes.Count > 0)
                {
                    <div class="alert alert-warning small">Danh mục còn công thức nên không xóa được. Hãy xóa hoặc chuyển các công thức sang danh mục khác trước.</div>
                }

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger" @(Model.Recipes.Count > 0 ? "disabled" : "")><i class="bi bi-trash"></i> Xóa</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Quay lại danh sách</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
