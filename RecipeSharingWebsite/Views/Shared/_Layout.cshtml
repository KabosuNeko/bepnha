@{
    // lay ten controller hien tai de to sang menu dang chon
    string ctrl = ViewContext.RouteData.Values["controller"].ToString();
    string act = ViewContext.RouteData.Values["action"].ToString();
    bool daDangNhap = Session["UserID"] != null;
    bool laAdmin = Session["IsAdmin"] != null && (bool)Session["IsAdmin"];
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Bếp Nhà</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-white site-head sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                <i class="bi bi-egg-fried text-accent"></i> Bếp Nhà
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "Home" && act == "Index" ? "active" : "")" href="@Url.Action("Index", "Home")">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ctrl == "Recipes" ? "active" : "")" href="@Url.Action("Index", "Recipes")">Công thức</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(act == "Contact" ? "active" : "")" href="@Url.Action("Contact", "Home")">Liên hệ</a>
                    </li>
                    @if (laAdmin)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ctrl == "Admin" ? "active" : "")" href="@Url.Action("Index", "Admin")">Duyệt bài</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ctrl == "Categories" ? "active" : "")" href="@Url.Action("Index", "Categories")">Danh mục</a>
                        </li>
                    }
                </ul>

                @using (Html.BeginForm("Index", "Recipes", FormMethod.Get, new { @class = "d-flex me-lg-3 mb-2 mb-lg-0", role = "search" }))
                {
                    <div class="input-group input-group-sm">
                        <input type="search" name="searchString" class="form-control" placeholder="Tìm món ăn..." aria-label="Tìm món ăn" />
                        <button class="btn btn-outline-secondary" type="submit" aria-label="Tìm"><i class="bi bi-search"></i></button>
                    </div>
                }

                @if (daDangNhap)
                {
                    <a class="btn btn-primary btn-sm me-2" href="@Url.Action("Create", "Recipes")">
                        <i class="bi bi-plus-lg"></i> Đăng công thức
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> @Session["FullName"]
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="@Url.Action("MyRecipes", "Account")"><i class="bi bi-journal-text me-2"></i>Bài của tôi</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                }
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-secondary btn-sm me-2" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                    <a class="btn btn-primary btn-sm" href="@Url.Action("Register", "Account")">Đăng ký</a>
                }
            </div>
        </div>
    </nav>

    @RenderSection("hero", required: false)

    <main class="container my-4 flex-grow-1">
        @if (TempData["Msg"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="bi bi-check-circle me-1"></i> @TempData["Msg"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["Err"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Err"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="site-foot py-3 mt-5">
        <div class="container">
            <p class="text-center text-muted small mb-0">&copy; @DateTime.Now.Year Bếp Nhà - Website chia sẻ công thức nấu ăn</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
