@model IEnumerable<RecipeSharingWebsite.Models.Recipe>
@using RecipeSharingWebsite.Models

@{
    ViewBag.Title = "Bài của tôi";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <span class="kicker">Tài khoản</span>
        <h1 class="mb-0">Bài của tôi</h1>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Create", "Recipes")"><i class="bi bi-plus-lg"></i> Đăng công thức mới</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Bạn chưa đăng công thức nào.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Món ăn</th>
                        <th>Ngày đăng</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@Url.Content(item.ImagePath ?? "~/Content/Images/placeholder.svg")" width="64" height="48" class="rounded object-fit-cover" alt="" />
                                    <a class="fw-semibold" href="@Url.Action("Details", "Recipes", new { id = item.RecipeID })">@item.Title</a>
                                </div>
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.Status == Recipe.DaDuyet)
                                {
                                    <span class="badge text-bg-success">Đã duyệt</span>
                                }
                                else if (item.Status == Recipe.ChoDuyet)
                                {
                                    <span class="badge text-bg-warning">Chờ duyệt</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Bị xóa</span>
                                    <div class="small text-danger mt-1"><i class="bi bi-chat-left-text me-1"></i>Lý do: @item.RejectReason</div>
                                }
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                @* sua xong bai se chuyen ve Cho duyet (ke ca bai bi xoa: sua lai roi gui duyet lai) *@
                                <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", "Recipes", new { id = item.RecipeID })"><i class="bi bi-pencil"></i> Sửa</a>
                                <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", "Recipes", new { id = item.RecipeID })"><i class="bi bi-trash"></i> Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
