@model IEnumerable<RecipeSharingWebsite.Models.Recipe>
@using RecipeSharingWebsite.Models

@{
    ViewBag.Title = "Trang chủ";
    // lấy 4 món mới nhất làm slide
    var slides = Model.Take(4).ToList();
}

@section hero {
    @* Slideshow làm nền, khối tìm kiếm "Hôm nay nấu gì?" nằm đè lên trên *@
    <section id="heroCarousel" class="carousel slide carousel-fade hero-slider" data-bs-ride="carousel" data-bs-interval="4000">
        <div class="carousel-inner">
            @for (int i = 0; i < slides.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Url.Content(slides[i].ImagePath ?? "~/Content/Images/placeholder.svg")" class="d-block w-100 hero-img" alt="@slides[i].Title" />
                    @* tên món ở góc dưới, bấm vào mở trang chi tiết *@
                    <a class="hero-dish" href="@Url.Action("Details", "Recipes", new { id = slides[i].RecipeID })">
                        @slides[i].Title <span class="opacity-75">· món của @slides[i].Author →</span>
                    </a>
                </div>
            }
        </div>

        @* Khối tìm kiếm: tìm theo tên món hoặc nguyên liệu *@
        <div class="hero-search">
            <div class="container" style="max-width: 720px">
                <h1 class="mb-2 text-white">Hôm nay nấu gì?</h1>
                <p class="mb-4 text-white opacity-75">Tìm trong các công thức nhà làm, theo tên món hoặc nguyên liệu bạn đang có.</p>
                @using (Html.BeginForm("Index", "Recipes", FormMethod.Get))
                {
                    <div class="input-group input-group-lg mb-3">
                        <input type="search" name="searchString" class="form-control" placeholder="Ví dụ: thịt bò, bún, cà chua..." aria-label="Tìm tên món hay nguyên liệu" />
                        <button type="submit" class="btn btn-primary px-4">Tìm</button>
                    </div>
                }
                <div>
                    <span class="text-white small me-2">Hay tìm:</span>
                    @foreach (var tu in new[] { "Bún", "Thịt heo", "Cá", "Đậu hũ", "Trứng", "Chè" })
                    {
                        <a class="tag" href="@Url.Action("Index", "Recipes", new { searchString = tu })">@tu</a>
                    }
                </div>
            </div>
        </div>

        <div class="carousel-indicators">
            @for (int i = 0; i < slides.Count; i++)
            {
                <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Slide @(i + 1)"></button>
            }
        </div>
    </section>
}

@* ===== Danh mục: ảnh tròn lấy từ món đầu tiên của danh mục ===== *@
<section class="mb-5">
    <h2 class="h4 mb-3">Danh mục</h2>
    <div class="d-flex flex-wrap gap-4">
        @foreach (var c in (List<Category>)ViewBag.Categories)
        {
            var anh = c.Recipes.Where(r => r.Status == Recipe.DaDuyet && r.ImagePath != null)
                               .Select(r => r.ImagePath).FirstOrDefault() ?? "~/Content/Images/placeholder.svg";
            <a class="cat-tile text-center" href="@Url.Action("Index", "Recipes", new { categoryID = c.CategoryID })">
                <img src="@Url.Content(anh)" alt="@c.CategoryName" />
                <div class="small fw-semibold mt-2">@c.CategoryName</div>
            </a>
        }
    </div>
</section>

@* ===== Món mới nhất ===== *@
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <h2 class="h4 mb-0">Món mới lên bếp</h2>
        <a class="text-accent" href="@Url.Action("Index", "Recipes")">Xem tất cả →</a>
    </div>
    <div class="row g-4">
        @foreach (var recipe in Model)
        {
            @Html.Partial("_RecipeCard", recipe)
        }
    </div>
</section>

@* ===== Món ngon của tuần ===== *@
@if (ViewBag.Featured != null)
{
    var featured = (Recipe)ViewBag.Featured;
    <section class="row g-0 bg-cream rounded-3 overflow-hidden featured mb-5">
        <div class="col-md-6">
            <img src="@Url.Content(featured.ImagePath ?? "~/Content/Images/placeholder.svg")" class="w-100" alt="@featured.Title" />
        </div>
        <div class="col-md-6 d-flex align-items-center">
            <div class="p-4 p-lg-5">
                <div class="text-accent fw-semibold mb-2">Món ngon của tuần</div>
                <h2>@featured.Title</h2>
                <p>@featured.Description</p>
                <p class="text-muted small mb-4">
                    @Html.Partial("_Avatar", featured.Author) @featured.Author · @featured.TotalTimeMinutes phút · @featured.Servings người
                </p>
                <a class="btn btn-primary px-4" href="@Url.Action("Details", "Recipes", new { id = featured.RecipeID })">Xem công thức</a>
            </div>
        </div>
    </section>
}
