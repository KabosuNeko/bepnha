@model IEnumerable<RecipeSharingWebsite.Models.Recipe>
@using System.Web.Routing

@{
    ViewBag.Title = "Công thức";
    string catID = Request.QueryString["categoryID"];
    string sort = Request.QueryString["sortStyle"];
    string doKho = Request.QueryString["difficulty"];
    string thoiGian = Request.QueryString["maxTime"];
    string search = ViewBag.SearchString;
    int trang = ViewBag.Page;
    int soTrang = ViewBag.TotalPages;
    // số bộ lọc đang chọn, hiện trên nút "Lọc" ở điện thoại
    int soBoLoc = new[] { catID, doKho, thoiGian }.Count(x => !string.IsNullOrEmpty(x));

    // tạo link giữ nguyên các bộ lọc đang chọn, chỉ đổi một giá trị; đổi bộ lọc thì quay về trang 1
    Func<string, object, string> Link = (key, value) =>
    {
        var rv = new RouteValueDictionary {
            { "searchString", search }, { "categoryID", catID }, { "difficulty", doKho },
            { "maxTime", thoiGian }, { "sortStyle", sort }
        };
        rv[key] = value;
        if (key == "page" && (int)value <= 1) { rv.Remove("page"); } // trang 1 thì không cần ghi ?page=1
        return Url.Action("Index", rv);
    };
}

@* CSS riêng của trang này *@
@section styles {
    <link rel="stylesheet" href="~/Content/pages/recipes.css" />
}

<div class="row g-4 g-lg-5">
    @* ===== Cột trái: tìm kiếm + danh sách ===== *@
    <div class="col-lg-8">
        @using (Html.BeginForm("Index", "Recipes", FormMethod.Get))
        {
            <label for="timMon" class="visually-hidden">Tìm tên món hay nguyên liệu</label>
            <div class="input-group mb-3">
                @Html.TextBox("searchString", null, new { @class = "form-control", id = "timMon", placeholder = "Tìm tên món hay nguyên liệu..." })
                <button type="submit" class="btn btn-primary px-4">Tìm</button>
            </div>
        }

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <h1 class="h4 mb-0">
                @(string.IsNullOrEmpty(search) ? "Tất cả công thức" : "Kết quả cho \"" + search + "\"")
                <span class="text-muted fw-normal">(@ViewBag.Total)</span>
            </h1>
            <div class="d-flex gap-2">
                @* điện thoại: bộ lọc nằm trong bảng trượt, bấm nút này để mở *@
                <button type="button" class="btn btn-outline-secondary d-lg-none" data-bs-toggle="offcanvas" data-bs-target="#boLoc" aria-controls="boLoc">
                    Lọc@(soBoLoc > 0 ? " (" + soBoLoc + ")" : "")
                </button>
                <div class="btn-group" role="group" aria-label="Sắp xếp">
                    <a class="btn btn-outline-secondary @(string.IsNullOrEmpty(sort) ? "active" : "")" href="@Link("sortStyle", null)">Mới nhất</a>
                    <a class="btn btn-outline-secondary @(sort == "name" || sort == "name_desc" ? "active" : "")" href="@Link("sortStyle", (string)ViewBag.NameSort)">Tên</a>
                    <a class="btn btn-outline-secondary @(sort == "time" || sort == "time_desc" ? "active" : "")" href="@Link("sortStyle", (string)ViewBag.TimeSort)">Thời gian</a>
                </div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-light border mt-3">
                Chưa có công thức nào phù hợp. @Html.ActionLink("Xem tất cả", "Index", null, new { @class = "alert-link" })
            </div>
        }

        @foreach (var item in Model)
        {
            @* mỗi món một hàng: ảnh trái, thông tin phải *@
            <a class="recipe-row" href="@Url.Action("Details", new { id = item.RecipeID })">
                <img src="@Url.Content(item.ImagePath ?? "~/Content/Images/placeholder.svg")" width="160" height="120" loading="lazy" alt="@item.Title" />
                <div class="flex-grow-1">
                    <h2 class="h5 mb-1">@item.Title</h2>
                    <p class="text-muted small mb-2 ingredients-line">@item.Ingredients.Replace("\n", ", ")</p>
                    <div class="small text-muted">
                        @item.TotalTimeMinutes phút · @item.Difficulty · @item.Servings người · @item.Category.CategoryName
                    </div>
                    <div class="small mt-1">@Html.Partial("_Avatar", item.Author) @item.Author</div>
                </div>
            </a>
        }

        @* ===== Phân trang ===== *@
        @if (soTrang > 1)
        {
            <nav class="mt-4" aria-label="Chuyển trang">
                <ul class="pagination flex-wrap">
                    <li class="page-item @(trang == 1 ? "disabled" : "")">
                        <a class="page-link" href="@Link("page", trang - 1)">Trước</a>
                    </li>
                    @for (int i = 1; i <= soTrang; i++)
                    {
                        <li class="page-item @(i == trang ? "active" : "")">
                            <a class="page-link" href="@Link("page", i)" @(i == trang ? "aria-current=page" : "")>@i</a>
                        </li>
                    }
                    <li class="page-item @(trang == soTrang ? "disabled" : "")">
                        <a class="page-link" href="@Link("page", trang + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        }
    </div>

    @* ===== Cột phải: lọc theo danh mục, độ khó, thời gian =====
       offcanvas-lg: trên điện thoại là bảng trượt từ phải, từ màn hình lg trở lên là cột bình thường *@
    <div class="col-lg-4">
      <div class="offcanvas-lg offcanvas-end" tabindex="-1" id="boLoc" aria-labelledby="boLocTieuDe">
        <div class="offcanvas-header border-bottom">
            <h2 class="offcanvas-title h5" id="boLocTieuDe">Lọc công thức</h2>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#boLoc" aria-label="Đóng"></button>
        </div>
        <div class="offcanvas-body d-block">
        <h2 class="h6 fw-bold mb-3">Danh mục</h2>
        <div class="list-group mb-4">
            <a class="list-group-item list-group-item-action @(string.IsNullOrEmpty(catID) ? "active" : "")" href="@Link("categoryID", null)">Tất cả</a>
            @foreach (var c in (List<RecipeSharingWebsite.Models.Category>)ViewBag.Categories)
            {
                <a class="list-group-item list-group-item-action @(catID == c.CategoryID.ToString() ? "active" : "")"
                   href="@Link("categoryID", c.CategoryID)">@c.CategoryName</a>
            }
        </div>

        <h2 class="h6 fw-bold mb-2">Độ khó</h2>
        <div class="d-flex flex-wrap gap-2 mb-4">
            <a class="btn btn-outline-secondary @(string.IsNullOrEmpty(doKho) ? "active" : "")" href="@Link("difficulty", null)">Tất cả</a>
            @foreach (var d in new[] { "Dễ", "Trung bình", "Khó" })
            {
                <a class="btn btn-outline-secondary @(doKho == d ? "active" : "")" href="@Link("difficulty", d)">@d</a>
            }
        </div>

        <h2 class="h6 fw-bold mb-2">Thời gian nấu</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary @(string.IsNullOrEmpty(thoiGian) ? "active" : "")" href="@Link("maxTime", null)">Tất cả</a>
            <a class="btn btn-outline-secondary @(thoiGian == "30" ? "active" : "")" href="@Link("maxTime", 30)">Tối đa 30 phút</a>
            <a class="btn btn-outline-secondary @(thoiGian == "60" ? "active" : "")" href="@Link("maxTime", 60)">Tối đa 1 giờ</a>
        </div>
        </div>
      </div>
    </div>
</div>
