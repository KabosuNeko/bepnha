@model RecipeSharingWebsite.Models.Recipe

@* Các ô nhập dùng chung cho Create và Edit. Người đăng lấy theo tài khoản nên không có ô nhập. *@

<div class="row g-3">
    <div class="col-md-8">
        @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "form-label fw-semibold" })
        @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control", placeholder = "Ví dụ: Phở bò" } })
        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-4">
        @Html.LabelFor(model => model.CategoryID, htmlAttributes: new { @class = "form-label fw-semibold" })
        @Html.DropDownListFor(model => model.CategoryID, (SelectList)ViewBag.CategoryList, "--Chọn danh mục--", htmlAttributes: new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger small" })
    </div>

    <div class="col-12">
        @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-label fw-semibold" })
        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = "2", placeholder = "Giới thiệu ngắn về món ăn" })
        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-5">
        @Html.LabelFor(model => model.Ingredients, htmlAttributes: new { @class = "form-label fw-semibold" })
        @Html.TextAreaFor(model => model.Ingredients, new { @class = "form-control", rows = "8", placeholder = "500 g thịt bò\n2 củ hành tím" })
        @Html.ValidationMessageFor(model => model.Ingredients, "", new { @class = "text-danger small" })
    </div>

    <div class="col-md-7">
        @Html.LabelFor(model => model.Instructions, htmlAttributes: new { @class = "form-label fw-semibold" })
        @Html.TextAreaFor(model => model.Instructions, new { @class = "form-control", rows = "8", placeholder = "1. Rửa sạch nguyên liệu\n2. Ướp thịt 30 phút" })
        @Html.ValidationMessageFor(model => model.Instructions, "", new { @class = "text-danger small" })
    </div>

    <div class="col-6 col-md-3">
        @Html.LabelFor(model => model.PrepTimeMinutes, htmlAttributes: new { @class = "form-label fw-semibold" })
        <div class="input-group">
            @Html.EditorFor(model => model.PrepTimeMinutes, new { htmlAttributes = new { @class = "form-control" } })
            <span class="input-group-text">phút</span>
        </div>
        @Html.ValidationMessageFor(model => model.PrepTimeMinutes, "", new { @class = "text-danger small" })
    </div>

    <div class="col-6 col-md-3">
        @Html.LabelFor(model => model.CookTimeMinutes, htmlAttributes: new { @class = "form-label fw-semibold" })
        <div class="input-group">
            @Html.EditorFor(model => model.CookTimeMinutes, new { htmlAttributes = new { @class = "form-control" } })
            <span class="input-group-text">phút</span>
        </div>
        @Html.ValidationMessageFor(model => model.CookTimeMinutes, "", new { @class = "text-danger small" })
    </div>

    <div class="col-6 col-md-3">
        @Html.LabelFor(model => model.Servings, htmlAttributes: new { @class = "form-label fw-semibold" })
        <div class="input-group">
            @Html.EditorFor(model => model.Servings, new { htmlAttributes = new { @class = "form-control" } })
            <span class="input-group-text">người</span>
        </div>
        @Html.ValidationMessageFor(model => model.Servings, "", new { @class = "text-danger small" })
    </div>

    <div class="col-6 col-md-3">
        @Html.LabelFor(model => model.Difficulty, htmlAttributes: new { @class = "form-label fw-semibold" })
        @Html.DropDownListFor(model => model.Difficulty, new SelectList(new[] { "Dễ", "Trung bình", "Khó" }), "--Chọn--", htmlAttributes: new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.Difficulty, "", new { @class = "text-danger small" })
    </div>

    @* ảnh món ăn: không bắt buộc; khi sửa bài thì hiện ảnh đang dùng *@
    <div class="col-12">
        <label for="anhMon" class="form-label fw-semibold">Ảnh món ăn</label>
        <div class="d-flex flex-wrap align-items-center gap-3">
            @if (!string.IsNullOrEmpty(Model?.ImagePath))
            {
                <img src="@Url.Content(Model.ImagePath)" width="120" height="80" class="rounded object-fit-cover" alt="Ảnh đang dùng" />
            }
            <div class="flex-grow-1">
                <input type="file" name="anhMon" id="anhMon" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="text-muted small mt-1">
                    @(string.IsNullOrEmpty(Model?.ImagePath) ? "Ảnh .jpg, .png hoặc .webp, tối đa 8 MB. Không chọn thì dùng ảnh mặc định." : "Chọn ảnh mới nếu muốn thay, tối đa 8 MB.")
                </div>
            </div>
        </div>
        @Html.ValidationMessage("ImagePath", "", new { @class = "text-danger small" })
        <div class="text-danger small" id="loiAnh" role="alert"></div>
    </div>
</div>

<script>
    // Báo ngay khi chọn ảnh quá lớn và bỏ file đó, để form không gửi lên server rồi ra trang lỗi
    document.getElementById('anhMon').addEventListener('change', function () {
        var toiDa = @RecipeSharingWebsite.Models.AnhMon.DungLuongToiDa;
        var loi = document.getElementById('loiAnh');
        if (this.files[0] && this.files[0].size > toiDa) {
            loi.textContent = 'Ảnh này nặng ' + (this.files[0].size / 1048576).toFixed(1) + ' MB, chỉ nhận ảnh tối đa 8 MB. Bạn chọn ảnh khác nhé.';
            this.value = '';
        } else {
            loi.textContent = '';
        }
    });
</script>
