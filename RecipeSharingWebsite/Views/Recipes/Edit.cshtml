@model RecipeSharingWebsite.Models.Recipe

@{
    ViewBag.Title = "Sửa công thức";
    bool laAdmin = RecipeSharingWebsite.Models.Quyen.LaAdmin(Session["IsAdmin"]);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Công thức</a></li>
        <li class="breadcrumb-item active" aria-current="page">Sửa công thức</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-xl-10">
        @if (ViewBag.Err != null)
        {
            <div class="alert alert-danger">@ViewBag.Err</div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-cream py-3">
                <h1 class="h3 mb-0">Sửa công thức</h1>
                <small class="text-muted">
                    Đang sửa: @Model.Title.
                    @(laAdmin ? "" : "Sau khi lưu, bài sẽ chờ admin duyệt lại.")
                </small>
            </div>
            <div class="card-body p-4">
                @* enctype multipart: bắt buộc để gửi được file ảnh lên server *@
                @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(model => model.RecipeID)

                    @Html.Partial("_RecipeForm")

                    <hr class="my-4" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.RecipeID })">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @* JS riêng của trang: kiểm tra và xem trước ảnh món ăn *@
    <script src="~/Scripts/pages/recipe-form.js"></script>
}
