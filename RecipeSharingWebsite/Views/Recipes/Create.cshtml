@model RecipeSharingWebsite.Models.Recipe

@{
    ViewBag.Title = "Đăng công thức";
    bool laAdmin = RecipeSharingWebsite.Models.Quyen.LaAdmin(Session["IsAdmin"]);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Công thức</a></li>
        <li class="breadcrumb-item active" aria-current="page">Đăng công thức</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-xl-10">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-cream py-3">
                <h1 class="h3 mb-0">Đăng công thức mới</h1>
                <small class="text-muted">
                    Người đăng: <strong>@Session["FullName"]</strong>.
                    @(laAdmin ? "Bài của admin hiện ngay." : "Bài sẽ hiện sau khi admin duyệt.")
                    Mỗi dòng trong phần nguyên liệu và các bước làm là một mục riêng.
                </small>
            </div>
            <div class="card-body p-4">
                @* enctype multipart: bắt buộc để gửi được file ảnh lên server *@
                @using (Html.BeginForm(null, null, FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    @Html.Partial("_RecipeForm")

                    <hr class="my-4" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Đăng công thức</button>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
