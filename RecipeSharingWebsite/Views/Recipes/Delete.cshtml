@model RecipeSharingWebsite.Models.Recipe

@{
    ViewBag.Title = "Xóa công thức";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("MyRecipes", "Account")">Bài của tôi</a></li>
        <li class="breadcrumb-item active" aria-current="page">Xóa công thức</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle me-1"></i> Bạn có chắc muốn xóa công thức này?
            </div>
            <div class="row g-0">
                <div class="col-md-5">
                    <img src="@Url.Content(Model.ImagePath ?? "~/Content/Images/placeholder.svg")" class="w-100 h-100 object-fit-cover" alt="@Model.Title" />
                </div>
                <div class="col-md-7">
                    <div class="card-body">
                        <span class="badge badge-accent">@Model.Category.CategoryName</span>
                        <h2 class="card-title h3 mt-2">@Model.Title</h2>
                        <p class="card-text">@Model.Description</p>
                        <p class="text-muted small">
                            <i class="bi bi-person me-1"></i>@Model.Author
                            <span class="mx-1">·</span><i class="bi bi-clock me-1"></i>@Model.TotalTimeMinutes phút
                        </p>
                        <div class="alert alert-warning small py-2">Thao tác này không thể hoàn tác.</div>

                        @using (Html.BeginForm())
                        {
                            @Html.AntiForgeryToken()
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Xóa</button>
                                <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = Model.RecipeID })">Hủy</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
