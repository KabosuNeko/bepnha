@model RecipeSharingWebsite.Models.Recipe
@using RecipeSharingWebsite.Models

@{
    ViewBag.Title = Model.Title;
    var ratings = Model.Ratings.OrderByDescending(r => r.CreatedAt).ToList();
    double diemTB = ratings.Any() ? ratings.Average(r => r.Stars) : 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", new { categoryID = Model.CategoryID })">@Model.Category.CategoryName</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

@* bài chưa duyệt / bị xóa: chỉ chủ bài và admin thấy trang này *@
@if (Model.Status == Recipe.ChoDuyet)
{
    <div class="alert alert-warning">Bài đang chờ admin duyệt, người khác chưa thấy bài này.</div>
}
else if (Model.Status == Recipe.BiXoa)
{
    <div class="alert alert-danger">Bài đã bị admin xóa. Lý do: @Model.RejectReason</div>
}

@* Bố cục 3 phần: đầu bài, nguyên liệu, các bước.
   Điện thoại: xếp dọc theo thứ tự đó (xem nguyên liệu trước khi nấu).
   Máy tính: nguyên liệu nằm cột phải và dính theo khi cuộn (xem .detail-layout trong Site.css). *@
<div class="detail-layout">
    <div class="detail-head">
        <h1 class="mb-3">@Model.Title</h1>

        @* người đăng *@
        <div class="d-flex align-items-center gap-3 mb-3">
            @Html.Partial("_Avatar", Model.Author, new ViewDataDictionary { { "size", "avatar-lg" } })
            <div>
                <a class="fw-semibold" href="@Url.Action("ByAuthor", new { name = Model.Author })">@Model.Author</a>
                <div class="text-muted small">Đăng ngày @Model.CreatedAt.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        @* lưu món và in công thức (ẩn khi in) *@
        <div class="d-flex flex-wrap gap-2 mb-4 no-print">
            @if (Model.Status == Recipe.DaDuyet)
            {
                using (Html.BeginForm("ToggleFavorite", "Recipes", new { id = Model.RecipeID }, FormMethod.Post, null))
                {
                    @Html.AntiForgeryToken()
                    @* gửi sẵn việc cần làm: chưa lưu thì gửi luu=true, đã lưu thì gửi luu=false *@
                    <input type="hidden" name="luu" value="@(ViewBag.DaLuu ? "false" : "true")" />
                    <button type="submit" class="btn @(ViewBag.DaLuu ? "btn-primary" : "btn-outline-primary")" aria-pressed="@(ViewBag.DaLuu ? "true" : "false")">
                        @(ViewBag.DaLuu ? "Đã lưu món" : "Lưu món")
                    </button>
                }
            }
            <button type="button" class="btn btn-outline-secondary" onclick="window.print()">In công thức</button>
        </div>

        <img src="@Url.Content(Model.ImagePath ?? "~/Content/Images/placeholder.svg")" class="w-100 rounded-3 detail-img mb-4" width="1280" height="720" fetchpriority="high" alt="@Model.Title" />

        <div class="author-note mb-4">
            <div class="fw-semibold mb-1">Lời của @Model.Author</div>
            <p class="mb-0">@Model.Description</p>
        </div>

        @* thông tin nhanh: 2 cột trên điện thoại, 4 cột trên máy tính *@
        <dl class="recipe-facts">
            <div><dt>Chuẩn bị</dt><dd>@Model.PrepTimeMinutes phút</dd></div>
            <div><dt>Nấu</dt><dd>@Model.CookTimeMinutes phút</dd></div>
            <div><dt>Khẩu phần</dt><dd>@Model.Servings người</dd></div>
            <div><dt>Độ khó</dt><dd>@Model.Difficulty</dd></div>
        </dl>
        @if (ratings.Any())
        {
            <p class="mb-0">
                @Html.Partial("_Stars", diemTB) <strong>@diemTB.ToString("0.0")</strong>
                <a class="text-muted no-print" href="#danh-gia">(@ratings.Count đánh giá)</a>
            </p>
        }
    </div>

    @* ===== Nguyên liệu: có ô tick để đánh dấu đã chuẩn bị ===== *@
    <aside class="detail-side bg-cream rounded-3 p-4">
        <h2 class="h5 mb-1">Nguyên liệu</h2>
        <p class="text-muted small mb-3">Cho @Model.Servings người · tick vào món đã chuẩn bị</p>
        <div class="ingredient-list" data-recipe="@Model.RecipeID">
            @* tách theo dòng, bỏ dòng trống (người đăng hay bấm Enter thừa ở cuối) *@
            @foreach (var item in Model.Ingredients.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
            {
                <label class="d-flex gap-2 py-2 border-bottom">
                    <input type="checkbox" class="form-check-input mt-1" />
                    <span>@item</span>
                </label>
            }
        </div>
    </aside>

    <div class="detail-steps">
        <h2 class="h4 mb-3">Các bước làm</h2>
        @{ int buoc = 1; }
        @foreach (var step in Model.Instructions.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
        {
            <div class="d-flex gap-3 mb-3">
                <span class="step-num rounded-circle d-flex align-items-center justify-content-center fw-bold">@buoc</span>
                @* bỏ số thứ tự "1. " ở đầu dòng vì đã có vòng tròn đánh số *@
                <p class="mb-0 pt-1">@(step.Length > 3 && char.IsDigit(step[0]) && step.Contains(". ") ? step.Substring(step.IndexOf(". ") + 2) : step)</p>
            </div>
            buoc++;
        }

        @if (ViewBag.DuocSua || ViewBag.LaChuBai)
        {
            <div class="d-flex gap-2 mt-4 no-print">
                @if (ViewBag.DuocSua)
                {
                    <a class="btn btn-outline-secondary" href="@Url.Action("Edit", new { id = Model.RecipeID })">Sửa bài</a>
                }
                @if (ViewBag.LaChuBai)
                {
                    <a class="btn btn-outline-danger" href="@Url.Action("Delete", new { id = Model.RecipeID })">Xóa bài</a>
                }
            </div>
        }
    </div>
</div>

@* ===== Đánh giá ===== *@
<section class="mt-5 col-lg-8 no-print" id="danh-gia">
    <h2 class="h4 mb-3">Đánh giá (@ratings.Count)</h2>

    @if (Model.Status == Recipe.DaDuyet)
    {
        if (ViewBag.LaChuBai)
        {
            <p class="text-muted mb-4">Đây là món của bạn nên bạn không tự đánh giá được.</p>
        }
        else if (ViewBag.DaDanhGia)
        {
            <p class="text-muted mb-4">Bạn đã đánh giá món này. Cảm ơn bạn!</p>
        }
        else if (Session["UserID"] != null)
        {
            using (Html.BeginForm("Rate", "Recipes", FormMethod.Post, new { @class = "mb-4" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="RecipeID" value="@Model.RecipeID" />
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label for="soSao" class="form-label small fw-semibold">Số sao</label>
                        <select name="Stars" id="soSao" class="form-select" required>
                            <option value="">Chọn số sao</option>
                            <option value="5">5 sao - Rất ngon</option>
                            <option value="4">4 sao - Ngon</option>
                            <option value="3">3 sao - Bình thường</option>
                            <option value="2">2 sao - Chưa ngon</option>
                            <option value="1">1 sao - Không ngon</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="nhanXet" class="form-label small fw-semibold">Nhận xét (không bắt buộc)</label>
                        <input type="text" name="Comment" id="nhanXet" class="form-control" maxlength="500" placeholder="Bạn nấu thử thấy sao?" />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">Gửi</button>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="mb-4"><a class="text-accent" href="@Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", new { id = Model.RecipeID }) })">Đăng nhập</a> để đánh giá món này.</p>
        }
    }

    @if (!ratings.Any())
    {
        <p class="text-muted">Chưa có ai đánh giá món này.</p>
    }
    @foreach (var r in ratings)
    {
        <div class="d-flex gap-3 py-3 border-bottom">
            @Html.Partial("_Avatar", r.ReviewerName)
            <div>
                <div><strong>@r.ReviewerName</strong> <span class="text-muted small ms-1">@r.CreatedAt.ToString("dd/MM/yyyy")</span></div>
                @Html.Partial("_Stars", (double)r.Stars)
                @if (!string.IsNullOrEmpty(r.Comment))
                {
                    <p class="mb-0 mt-1">@r.Comment</p>
                }
            </div>
        </div>
    }
</section>

@* ===== Món liên quan: cùng danh mục ===== *@
@{ var related = (List<Recipe>)ViewBag.Related; }
@if (related.Any())
{
    <section class="mt-5 no-print">
        <h2 class="h4 mb-3">Món khác trong mục @Model.Category.CategoryName</h2>
        <div class="row g-4">
            @foreach (var r in related)
            {
                @Html.Partial("_RecipeCard", r)
            }
        </div>
    </section>
}

@section scripts {
    <script>
        // Tick nguyên liệu đã chuẩn bị; lưu vào localStorage để mở lại trang vẫn còn
        var khung = document.querySelector('.ingredient-list');
        var khoa = 'nguyenlieu-' + khung.dataset.recipe;
        var daTick = JSON.parse(localStorage.getItem(khoa) || '[]');
        var oTick = khung.querySelectorAll('input[type=checkbox]');

        oTick.forEach(function (o, i) {
            o.checked = daTick.indexOf(i) >= 0;
            o.addEventListener('change', function () {
                var ds = [];
                oTick.forEach(function (x, j) { if (x.checked) ds.push(j); });
                localStorage.setItem(khoa, JSON.stringify(ds));
            });
        });
    </script>
}
